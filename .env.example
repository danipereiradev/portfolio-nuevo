# Website ID de Crisp (Ajustes → Configuración del sitio web).
# Opcional: si no está, se usa el ID del código.
VITE_CRISP_WEBSITE_ID=dfd05fb5-ada2-4d14-a2a7-d0df20eacfb4

# Stripe Checkout de Google Ads (solo servidor; no usar VITE_).
# Precios en Stripe: 250 € one-time y 200 €/mes recurring, IVA 21 % aparte.
STRIPE_SECRET_KEY=
STRIPE_GOOGLE_ADS_SETUP_PRICE_ID=
STRIPE_GOOGLE_ADS_MONTHLY_PRICE_ID=
SITE_URL=https://36web.es

